---
const achievements = [
    { rank: "\ud83e\udd48 2nd Place", event: "IIT Mandi E-Summit \u201926 Case Competition", detail: "Analysed Zomato\u2019s large-scale dataset; delivered data-driven strategic recommendations to improve demand insights & operational efficiency." },
    { rank: "\ud83e\udd47 Rank 1", event: "IIM Mumbai \u2014 PocketJoystick", detail: "Recognised for exceptional product viability and strategic pitch execution." },
    { rank: "\ud83c\udfc5 National Finalist", event: "MICA, Kaleidoscope \u2014 MICANVAS", detail: "Recognised for innovative marketing strategy." },
    { rank: "\ud83c\udfc5 National Finalist", event: "UCB Case Study, IIT Madras", detail: "Recognised for strategic problem-solving and business case analysis." },
    { rank: "\ud83c\udfa8 Vice President", event: "Art Club, Bennett University", detail: "Led creative initiatives and art events across campus." },
    { rank: "\u2b50 5-Star Python", event: "HackerRank", detail: "Top rating in Python on HackerRank platform." },
    { rank: "\u2b50 3-Star", event: "CodeChef", detail: "Competitive programming rating on CodeChef." },
];
---
<section class="reveal-section">
    <h2 class="section-title">Achievements</h2>
    <div class="space-y-4 mt-6">
        {achievements.map((item) => (
            <div class="glass-card px-6 py-5 flex flex-col md:flex-row md:items-center gap-4 hover:border-white/40 transition-all">
                <span class="text-lg font-bold text-white min-w-[150px]">{item.rank}</span>
                <div>
                    <p class="text-white font-semibold text-base">{item.event}</p>
                    <p class="text-gray-300 text-sm mt-1">{item.detail}</p>
                </div>
            </div>
        ))}
    </div>
</section>
