---
const education = [
    { degree: "PGDM (RBA)", institution: "WeSchool, Mumbai", year: "2025–27", score: "Current", icon: "🎓" },
    { degree: "BCA – Data Science", institution: "Bennett University", year: "2020–23", score: "89%", icon: "🏫" },
    { degree: "Class XII (BIEAP)", institution: "Sri Chaitanya", year: "2020", score: "77.9%", icon: "📘" },
    { degree: "Class X (ICSE)", institution: "Loyola School", year: "2018", score: "71.4%", icon: "📗" },
];
---
<section class="reveal-section">
    <h2 class="section-title">Education</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6 reveal-stagger">
        {education.map((edu) => (
            <div class="stagger-child glass-card p-6 flip-card group cursor-default">
                <div class="flex items-start justify-between">
                    <div>
                        <span class="text-2xl">{edu.icon}</span>
                        <h3 class="text-lg font-bold text-white mt-2">{edu.degree}</h3>
                        <p class="text-gray-400 text-sm">{edu.institution}</p>
                        <p class="text-gray-500 text-xs mt-1">{edu.year}</p>
                    </div>
                    <div class="text-right">
                        <span class="text-2xl font-bold text-white">{edu.score}</span>
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>
