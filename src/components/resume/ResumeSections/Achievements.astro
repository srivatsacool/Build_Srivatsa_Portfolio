---
const achievements = [
    { rank: "🥈 2nd Place", event: "IIT Mandi E-Summit '26 Case Competition", detail: "Analysed Zomato's large-scale dataset; delivered data-driven strategic recommendations to improve demand insights & operational efficiency." },
    { rank: "🥇 Rank 1", event: "IIM Mumbai — PocketJoystick", detail: "Recognised for exceptional product viability and strategic pitch execution." },
    { rank: "🏅 National Finalist", event: "MICA, Kaleidoscope — MICANVAS", detail: "Recognised for innovative marketing strategy." },
    { rank: "🏅 National Finalist", event: "UCB Case Study, IIT Madras", detail: "Recognised for strategic problem-solving and business case analysis." },
    { rank: "🎨 Vice President", event: "Art Club, Bennett University", detail: "Led creative initiatives and art events across campus." },
    { rank: "⭐ 5-Star Python", event: "HackerRank", detail: "Top rating in Python on HackerRank platform." },
    { rank: "⭐ 3-Star", event: "CodeChef", detail: "Competitive programming rating on CodeChef." },
];
---
<section class="reveal-section">
    <h2 class="section-title">Achievements</h2>
    <div class="space-y-3 mt-6 reveal-stagger">
        {achievements.map((item) => (
            <div class="stagger-child glass-card px-6 py-4 flex flex-col md:flex-row md:items-center gap-3 hover:border-white/30 transition-all">
                <span class="text-lg font-bold text-white min-w-[130px]">{item.rank}</span>
                <div>
                    <p class="text-white font-semibold text-sm">{item.event}</p>
                    <p class="text-gray-400 text-xs mt-0.5">{item.detail}</p>
                </div>
            </div>
        ))}
    </div>
</section>
