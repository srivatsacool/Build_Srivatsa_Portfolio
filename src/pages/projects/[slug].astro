---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects } from "../../utils/getProjects";
import DitherBackground from "../../components/reactbits/dither/DitherBackground.tsx";

export async function getStaticPaths() {
    const projects = await getProjects();
    return projects.map((project) => ({
        params: { slug: project.slug },
        props: { project, allProjects: projects },
    }));
}

const { project, allProjects } = Astro.props;
const idx = allProjects.findIndex((p: any) => p.slug === project.slug);
const prev = idx > 0 ? allProjects[idx - 1] : null;
const next = idx < allProjects.length - 1 ? allProjects[idx + 1] : null;
const hasLong = project.longDescription && project.longDescription !== project.shortDescription;
---

<BaseLayout title={`${project.title} | Srivatsa Gorti`}>
    <div class="fixed inset-0 z-0">
        <DitherBackground client:only="react" />
        <div class="absolute inset-0 bg-black/75 pointer-events-none"></div>
    </div>

    <main class="relative z-10 min-h-screen font-body">

        <!-- Nav -->
        <nav class="sticky top-0 z-50 px-6 py-4 flex items-center justify-between nav-bar">
            <a href="/projects" class="back-btn">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                All Projects
            </a>
            <span class="counter">
                <strong>{String(project.order).padStart(2,'0')}</strong>
                <span class="sep">/</span>
                {String(allProjects.length).padStart(2,'0')}
            </span>
        </nav>

        <!-- ═══ SPLIT HERO ═══════════════════════════════════════════ -->
        <section class="split-hero">

            <!-- LEFT: Image -->
            <div class="split-image">
                {project.image
                    ? <img src={project.image} alt={project.title} class="hero-img" loading="eager" />
                    : <div class="hero-img-placeholder"></div>
                }
                <div class="img-vignette"></div>
            </div>

            <!-- RIGHT: Content -->
            <div class="split-content">

                <!-- Tags -->
                {project.tags && project.tags.length > 0 && (
                    <div class="tags-row">
                        {project.tags.map((t: string) => <span class="tag">{t}</span>)}
                    </div>
                )}

                <!-- Title + short desc -->
                <h1 class="proj-title">{project.title}</h1>
                <p class="short-desc">{project.shortDescription}</p>

                <!-- CTA buttons -->
                <div class="cta-row">
                    {project.demoUrl && (
                        <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                            Live Demo
                        </a>
                    )}
                    {project.repoUrl && (
                        <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost">
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                            View Code
                        </a>
                    )}
                </div>

                <!-- Long Description in right column -->
                {hasLong && (
                    <div class="long-desc-card">
                        <p class="long-desc-text">{project.longDescription}</p>
                    </div>
                )}
            </div>
        </section>

        <!-- ═══ BOTTOM FULL-WIDTH ════════════════════════════════════ -->
        <div class="bottom-grid">

            <!-- Tech Stack chips -->
            {project.techStack && project.techStack.length > 0 && (
                <section class="bottom-section">
                    <h2 class="section-label">Tech Stack</h2>
                    <div class="tech-chips">
                        {project.techStack.map((t: string) => (
                            <span class="tech-chip">
                                <span class="chip-dot"></span>
                                {t}
                            </span>
                        ))}
                    </div>
                </section>
            )}

            <!-- Links -->
            <section class="bottom-section">
                <h2 class="section-label">Links</h2>
                <div class="links-list">
                    {project.repoUrl && (
                        <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="link-row github-row">
                            <span class="link-icon">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                            </span>
                            <span class="link-body">
                                <span class="link-title">GitHub Repository</span>
                                <span class="link-url">{project.repoUrl.replace('https://','')}</span>
                            </span>
                            <svg class="arrow" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
                        </a>
                    )}
                    {project.demoUrl && (
                        <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="link-row demo-row">
                            <span class="link-icon">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                            </span>
                            <span class="link-body">
                                <span class="link-title">Live Demo</span>
                                <span class="link-url">{project.demoUrl.replace('https://','')}</span>
                            </span>
                            <svg class="arrow" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
                        </a>
                    )}
                    {!project.repoUrl && !project.demoUrl && (
                        <p class="no-links">No public links available.</p>
                    )}
                </div>
            </section>
        </div>

        <!-- ═══ PREV / NEXT ══════════════════════════════════════════ -->
        <div class="pn-nav">
            {prev ? (
                <a href={`/projects/${prev.slug}`} class="pn-card">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                    <span class="pn-info">
                        <span class="pn-label">Previous</span>
                        <span class="pn-name">{prev.title}</span>
                    </span>
                </a>
            ) : <div />}
            {next ? (
                <a href={`/projects/${next.slug}`} class="pn-card pn-right">
                    <span class="pn-info pn-info-r">
                        <span class="pn-label">Next</span>
                        <span class="pn-name">{next.title}</span>
                    </span>
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            ) : <div />}
        </div>

    </main>
</BaseLayout>

<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&display=swap');

:root {
    --bg:      #0F172A;
    --surf:    rgba(15,23,42,0.7);
    --border:  rgba(255,255,255,0.08);
    --txt:     #F1F5F9;
    --muted:   #94A3B8;
    --accent:  #3B82F6;
    --glow:    rgba(59,130,246,0.25);
    --r:       12px;
    --ease:    200ms cubic-bezier(0.4,0,0.2,1);
}

.font-body { font-family:'DM Sans',sans-serif; }

/* ── Nav ── */
.nav-bar {
    background: rgba(15,23,42,0.8);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
}
.back-btn {
    display:inline-flex; align-items:center; gap:8px;
    color:var(--muted); text-decoration:none; font-size:.875rem; font-weight:500;
    transition:color var(--ease); cursor:pointer;
}
.back-btn:hover { color:var(--txt); }
.counter { font-family:'Space Grotesk',sans-serif; font-size:.75rem; color:var(--muted); letter-spacing:.08em; }
.counter strong { color:var(--txt); }
.sep { margin:0 4px; }

/* ── SPLIT HERO ── */
.split-hero {
    display:grid;
    grid-template-columns: 44% 1fr;
    min-height:65vh;
    gap:0;
    margin-top: 48px;
}

/* Left: Image */
.split-image {
    position:relative;
    overflow:hidden;
    border-right:1px solid var(--border);
}
.hero-img {
    width:100%; height:100%;
    object-fit:cover; object-position:center top;
    display:block;
}
.hero-img-placeholder {
    width:100%; height:100%;
    background: linear-gradient(135deg,#1E293B 0%,#0F172A 100%);
}
.img-vignette {
    position:absolute; inset:0;
    background: linear-gradient(to right, transparent 60%, var(--bg) 100%);
    pointer-events:none;
}

/* Right: Content */
.split-content {
    display:flex;
    flex-direction:column;
    gap:22px;
    padding:40px 48px 40px 52px;
}

/* Tags */
.tags-row { display:flex; flex-wrap:wrap; gap:8px; }
.tag {
    padding:4px 12px;
    background:rgba(59,130,246,0.1);
    border:1px solid rgba(59,130,246,0.28);
    border-radius:999px;
    font-family:'Space Grotesk',sans-serif;
    font-size:.7rem; font-weight:700;
    color:#93C5FD;
    letter-spacing:.1em; text-transform:uppercase;
}

/* Title */
.proj-title {
    font-family:'Space Grotesk',sans-serif;
    font-size:clamp(1.75rem,3.5vw,2.75rem);
    font-weight:700; line-height:1.1;
    letter-spacing:-.02em;
    color:var(--txt); margin:0;
}

/* Short desc */
.short-desc {
    font-size:1.05rem; line-height:1.7;
    color:#CBD5E1; margin:0;
    max-width:520px;
}

/* CTAs */
.cta-row { display:flex; flex-wrap:wrap; gap:12px; }
.btn-primary, .btn-ghost {
    display:inline-flex; align-items:center; gap:8px;
    padding:11px 22px; border-radius:999px;
    font-family:'Space Grotesk',sans-serif;
    font-size:.875rem; font-weight:600;
    text-decoration:none; cursor:pointer;
    transition:all var(--ease);
}
.btn-primary {
    background:var(--accent); color:#fff;
    border:1px solid transparent;
    box-shadow:0 0 20px var(--glow);
}
.btn-primary:hover { background:#2563EB; box-shadow:0 0 30px rgba(59,130,246,.5); transform:translateY(-1px); }
.btn-ghost {
    background:rgba(255,255,255,.07); color:var(--txt);
    border:1px solid var(--border);
    backdrop-filter:blur(8px);
}
.btn-ghost:hover { background:rgba(255,255,255,.12); border-color:rgba(255,255,255,.2); transform:translateY(-1px); }

/* Long desc card in right column */
.long-desc-card {
    margin-top:8px;
    padding:24px 28px;
    background:rgba(30,41,59,0.5);
    border:1px solid var(--border);
    border-radius:var(--r);
    backdrop-filter:blur(12px);
    flex:1;
}
.long-desc-text {
    font-size:.9375rem; line-height:1.85;
    color:#94A3B8; margin:0;
}

/* ── Bottom Full-Width ── */
.bottom-grid {
    max-width:1200px;
    margin:0 auto;
    padding:52px 48px 40px;
    display:flex;
    flex-direction:column;
    gap:48px;
}

.bottom-section { display:flex; flex-direction:column; gap:24px; align-items:center; text-align:center; }

.section-label {
    font-family:'Space Grotesk',sans-serif;
    font-size:.65rem; font-weight:700;
    letter-spacing:.15em; text-transform:uppercase;
    color:var(--accent); margin:0;
    padding-bottom:10px;
    border-bottom:1px solid var(--border);
    display:inline-block;
}

/* Tech Chips */
.tech-chips { display:flex; flex-wrap:wrap; justify-content:center; gap:10px; max-width:800px; }
.tech-chip {
    display:inline-flex; align-items:center; gap:8px;
    padding:7px 14px;
    background:rgba(30,41,59,0.6);
    border:1px solid var(--border);
    border-radius:var(--r);
    font-size:.85rem; font-weight:500;
    color:var(--txt);
    transition:border-color var(--ease), background var(--ease);
    cursor:default;
}
.tech-chip:hover { border-color:var(--accent); background:rgba(59,130,246,.08); }
.chip-dot {
    width:6px; height:6px; border-radius:50%;
    background:var(--accent);
    box-shadow:0 0 6px var(--glow);
    flex-shrink:0;
}

/* Links */
.links-list { display:flex; flex-direction:column; gap:12px; width:100%; max-width:600px; margin:0 auto; }
.link-row {
    display:flex; align-items:center; gap:16px;
    padding:16px 20px;
    background:rgba(30,41,59,0.5);
    border:1px solid var(--border);
    border-radius:var(--r);
    text-decoration:none; cursor:pointer;
    transition:all var(--ease);
    backdrop-filter:blur(10px);
    text-align:left;
}
.link-row:hover { transform:translateX(4px); }
.github-row:hover { border-color:rgba(139,92,246,.45); background:rgba(139,92,246,.07); }
.demo-row:hover   { border-color:rgba(59,130,246,.45); background:rgba(59,130,246,.07); }

.link-icon {
    width:40px; height:40px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    background:rgba(255,255,255,.05);
    border:1px solid var(--border); border-radius:10px;
    color:var(--muted);
    transition:color var(--ease);
}
.link-row:hover .link-icon { color:var(--txt); }

.link-body { display:flex; flex-direction:column; gap:3px; flex:1; min-width:0; }
.link-title { font-family:'Space Grotesk',sans-serif; font-size:.875rem; font-weight:600; color:var(--txt); }
.link-url { font-size:.72rem; color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

.arrow { color:var(--muted); flex-shrink:0; transition:transform var(--ease), color var(--ease); }
.link-row:hover .arrow { transform:translate(2px,-2px); color:var(--txt); }

.no-links { color:var(--muted); font-size:.875rem; font-style:italic; }

/* ── Prev / Next ── */
.pn-nav {
    max-width:1200px; margin:0 auto;
    padding:0 48px 72px;
    display:grid; grid-template-columns:1fr 1fr; gap:16px;
}
.pn-card {
    display:flex; align-items:center; gap:14px;
    padding:18px 22px;
    background:rgba(30,41,59,0.5);
    border:1px solid var(--border); border-radius:var(--r);
    text-decoration:none; cursor:pointer;
    transition:all var(--ease); backdrop-filter:blur(10px);
}
.pn-card:hover { border-color:rgba(255,255,255,.18); background:rgba(255,255,255,.05); }
.pn-card svg { color:var(--muted); flex-shrink:0; transition:transform var(--ease); }
.pn-card:not(.pn-right):hover svg { transform:translateX(-3px); }
.pn-right { justify-content:flex-end; }
.pn-right:hover svg { transform:translateX(3px); }
.pn-info { display:flex; flex-direction:column; gap:3px; min-width:0; }
.pn-info-r { align-items:flex-end; }
.pn-label { font-size:.65rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); font-family:'Space Grotesk',sans-serif; }
.pn-name { font-family:'Space Grotesk',sans-serif; font-size:.85rem; font-weight:600; color:var(--txt); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:220px; }

/* ── Responsive ── */
@media (max-width:900px) {
    .split-hero { grid-template-columns:1fr; min-height:auto; }
    .split-image { height:45vw; min-height:280px; border-right:none; border-bottom:1px solid var(--border); }
    .img-vignette { background:linear-gradient(to bottom,transparent 60%,var(--bg) 100%); }
    .split-content { padding:36px 24px 32px; }
    .bottom-grid { grid-template-columns:1fr; padding:36px 24px 28px; gap:36px; }
    .pn-nav { padding:0 24px 56px; }
}
@media (max-width:480px) {
    .pn-nav { grid-template-columns:1fr; }
    .proj-title { font-size:1.6rem; }
}
</style>
