---
import { Image } from 'astro:assets';

interface Props {
    title: string;
    description: string;
    date: string;
    readTime: string;
    tags: string[];
    slug: string;
    image?: string;
    index?: number;
}

const {
    title,
    description,
    date,
    readTime,
    tags,
    slug,
    image,
    index = 0,
} = Astro.props;

// Format date
const formattedDate = new Date(date).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
---

<a href={`/blog/${slug}`} class="blog-card group" style={`--index: ${index};`}>
    <!-- Glow Effect -->
    <div class="card-glow"></div>

    <!-- Card Content -->
    <div class="card-inner">
        <!-- Image Section (Optional) -->
        {
            image && (
                <div class="card-image">
                    <Image 
                        src={image} 
                        alt={title} 
                        width={600} 
                        height={340} 
                        loading="lazy"
                    />
                    <div class="image-overlay" />
                </div>
            )
        }

        <!-- Content Section -->
        <div class="card-content">
            <!-- Tags -->
            <div class="tags">
                {tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
            </div>

            <!-- Title -->
            <h3 class="card-title">{title}</h3>

            <!-- Description -->
            <p class="card-description">{description}</p>

            <!-- Meta Info -->
            <div class="card-meta">
                <span class="date">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"
                        ></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    {formattedDate}
                </span>
                <span class="read-time">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    {readTime}
                </span>
            </div>

            <!-- Read More Arrow -->
            <div class="read-more">
                <span>Read Article</span>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </div>
        </div>
    </div>
</a>

<style>
    .blog-card {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        border-radius: 20px;
        text-decoration: none;
        color: inherit;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        animation: fadeInUp 0.6s ease-out forwards;
        animation-delay: calc(var(--index) * 0.1s);
        opacity: 0;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .blog-card:hover {
        transform: translateY(-8px) scale(1.02);
    }

    /* Glow Effect */
    .card-glow {
        position: absolute;
        inset: -2px;
        border-radius: 22px;
        background: linear-gradient(
            135deg,
            rgba(139, 92, 246, 0.5) 0%,
            rgba(59, 130, 246, 0.5) 50%,
            rgba(236, 72, 153, 0.5) 100%
        );
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: -1;
        filter: blur(15px);
    }

    .blog-card:hover .card-glow {
        opacity: 0.6;
    }

    /* Glass Card Inner */
    .card-inner {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        background: linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.08) 0%,
            rgba(255, 255, 255, 0.02) 100%
        );
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow:
            0 8px 32px rgba(0, 0, 0, 0.3),
            inset 0 1px 0 rgba(255, 255, 255, 0.1);
        transition: all 0.4s ease;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .blog-card:hover .card-inner {
        border-color: rgba(139, 92, 246, 0.5);
        background: linear-gradient(
            135deg,
            rgba(0, 0, 0, 0.6) 0%,
            rgba(0, 0, 0, 0.4) 100%
        );
        box-shadow:
            0 16px 48px rgba(0, 0, 0, 0.5),
            inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }

    /* Image Section */
    .card-image {
        position: relative;
        width: 100%;
        height: 180px;
        overflow: hidden;
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .blog-card:hover .card-image img {
        transform: scale(1.1);
    }

    .image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            transparent 0%,
            rgba(11, 14, 20, 0.8) 100%
        );
    }

    /* Content Section */
    .card-content {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    /* Tags */
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .tag {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: rgba(139, 92, 246, 1);
        background: rgba(139, 92, 246, 0.15);
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-radius: 100px;
        transition: all 0.3s ease;
    }

    .blog-card:hover .tag {
        background: rgba(139, 92, 246, 0.25);
        border-color: rgba(139, 92, 246, 0.5);
    }

    /* Title */
    .card-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.75rem;
        line-height: 1.3;
        transition: color 0.3s ease;
    }

    .blog-card:hover .card-title {
        color: #ffffff;
        text-shadow:
            0 0 20px rgba(139, 92, 246, 0.8),
            0 0 40px rgba(139, 92, 246, 0.4);
    }

    /* Description */
    .card-description {
        font-size: 0.95rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 1.25rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color 0.3s ease;
    }

    .blog-card:hover .card-description {
        color: rgba(255, 255, 255, 0.9);
    }

    /* Meta Info */
    .card-meta {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.4);
        margin-bottom: 1rem;
        transition: color 0.3s ease;
    }

    .blog-card:hover .card-meta {
        color: rgba(255, 255, 255, 0.8);
    }

    .card-meta span {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .card-meta svg {
        opacity: 0.6;
        transition: opacity 0.3s ease;
    }

    .blog-card:hover .card-meta svg {
        opacity: 1;
    }

    /* Read More */
    .read-more {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: rgba(139, 92, 246, 0.8);
        opacity: 0;
        transform: translateX(-10px);
        transition: all 0.3s ease;
        margin-top: auto;
    }

    .blog-card:hover .read-more {
        opacity: 1;
        transform: translateX(0);
    }

    .read-more svg {
        transition: transform 0.3s ease;
    }

    .blog-card:hover .read-more svg {
        transform: translateX(5px);
    }

    /* Responsive */
    @media (max-width: 768px) {
        .card-title {
            font-size: 1.25rem;
        }

        .card-description {
            font-size: 0.9rem;
        }

        .card-meta {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }
    }
</style>
