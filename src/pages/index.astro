---
import BaseLayout from "../layouts/BaseLayout.astro";
import DitherBackground from "../components/reactbits/dither/DitherBackground.jsx";
import HeroText from "../components/home/HeroText.jsx";
import CTAButtons from "../components/home/CTAButtons.astro";
---

<BaseLayout title="Srivatsa Gorti | Portfolio">
	<!-- Background: transition:persist keeps dither alive across navigations -->
	<div class="fixed inset-0 z-0" transition:persist>
		<DitherBackground client:only="react" />
	</div>

	<!-- Main Content -->
	<main
		class="relative z-10 flex flex-col items-center justify-center h-screen w-full px-4 overflow-hidden"
		transition:name="main-content"
		transition:animate="slide"
	>
		<HeroText client:load />
		<CTAButtons />
	</main>
</BaseLayout>
