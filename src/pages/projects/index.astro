---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CursorOverlay from "../../components/shared/CursorOverlay.jsx";
import DitherBackground from "../../components/reactbits/dither/DitherBackground.tsx";
import ProjectsViewManager from "../../components/projects/ProjectsViewManager.tsx";
import { getProjects } from "../../utils/getProjects";
import "../../styles/projects-grid.css";

const projects = await getProjects();
---

<BaseLayout title="Projects | Srivatsa Gorti">
    <!-- Background: transition:persist keeps dither alive across navigations -->
    <div class="fixed inset-0 z-0" transition:persist>
        <DitherBackground client:only="react" />
        <div class="absolute inset-0 bg-black/60"></div>
    </div>

    <!-- Projects View Manager (handles globe ↔ grid toggle) -->
    <main transition:name="main-content" transition:animate="slide">
        <ProjectsViewManager client:only="react" projects={projects} />
    </main>

    <CursorOverlay client:only="react" />
</BaseLayout>
