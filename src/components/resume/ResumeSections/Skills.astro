---
const skillGroups = [
    {
        label: "Data Analysis",
        icon: "📊",
        skills: ["Python", "SQL", "Excel"]
    },
    {
        label: "Visualization",
        icon: "📈",
        skills: ["Power BI", "Tableau", "Matplotlib", "Streamlit"]
    },
    {
        label: "Languages",
        icon: "💻",
        skills: ["C", "C++", "HTML5", "JavaScript"]
    },
    {
        label: "Tools",
        icon: "🛠️",
        skills: ["MS Office", "Microsoft Automate", "OpenCV", "EasyOCR"]
    },
];
---
<section class="reveal-section">
    <h2 class="section-title">Skills</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6 reveal-stagger">
        {skillGroups.map((group) => (
            <div class="stagger-child glass-card p-6">
                <div class="flex items-center gap-2 mb-4">
                    <span class="text-xl">{group.icon}</span>
                    <h3 class="text-white font-semibold">{group.label}</h3>
                </div>
                <div class="flex flex-wrap gap-2">
                    {group.skills.map(skill => (
                        <span class="skill-pill px-3 py-1 text-sm rounded-full bg-white/8 border border-white/15 text-gray-200 hover:bg-white/20 hover:border-white/40 transition-all cursor-default">{skill}</span>
                    ))}
                </div>
            </div>
        ))}
    </div>
</section>
