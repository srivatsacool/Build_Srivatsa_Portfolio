---
import { Image } from 'astro:assets';

interface Props {
    title: string;
    description: string;
    image?: string;
    tags?: string[];
    repoUrl?: string;
    demoUrl?: string;
    slug: string;
    index?: number;
}

const {
    title,
    description,
    image,
    tags = [],
    repoUrl,
    demoUrl,
    slug,
    index = 0,
} = Astro.props;
---

<div class="project-card group" style={`--index: ${index};`}>
    <!-- Glow Effect -->
    <div class="card-glow"></div>

    <!-- Card Inner -->
    <div class="card-inner">
        <!-- Image Section -->
        {
            image && (
                <div class="card-image">
                    <Image 
                        src={image} 
                        alt={title} 
                        width={800} 
                        height={450} 
                        loading="lazy"
                    />
                    <div class="image-overlay" />
                </div>
            )
        }

        <!-- Content Section -->
        <div class="card-content">
            <!-- Tags -->
            {
                tags.length > 0 && (
                    <div class="tags">
                        {tags.slice(0, 3).map((tag) => (
                            <span class="tag">{tag}</span>
                        ))}
                    </div>
                )
            }

            <!-- Title -->
            <h3 class="card-title">
                <a href={`/projects/${slug}`} class="title-link">{title}</a>
            </h3>

            <!-- Description -->
            <p class="card-description">{description}</p>

            <!-- Actions -->
            <div class="card-actions">
                <a href={`/projects/${slug}`} class="action-link details-link">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <span>Details</span>
                </a>
                {
                    repoUrl && (
                        <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="action-link github-link">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                                <path d="M9 18c-4.51 2-5-2-7-2" />
                            </svg>
                            <span>GitHub</span>
                        </a>
                    )
                }
                {
                    demoUrl && (
                        <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="action-link demo-link">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                <polyline points="15 3 21 3 21 9"></polyline>
                                <line x1="10" y1="14" x2="21" y2="3"></line>
                            </svg>
                            <span>Live Demo</span>
                        </a>
                    )
                }
            </div>
        </div>
    </div>
</div>

<style>
    .project-card {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        border-radius: 20px;
        color: inherit;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        animation: fadeInUp 0.6s ease-out forwards;
        animation-delay: calc(var(--index) * 0.1s);
        opacity: 0;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .project-card:hover {
        transform: translateY(-8px) scale(1.02);
    }

    /* Glow Effect */
    .card-glow {
        position: absolute;
        inset: -2px;
        border-radius: 22px;
        background: linear-gradient(
            135deg,
            rgba(139, 92, 246, 0.5) 0%,
            rgba(59, 130, 246, 0.5) 50%,
            rgba(236, 72, 153, 0.5) 100%
        );
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: -1;
        filter: blur(15px);
    }

    .project-card:hover .card-glow {
        opacity: 0.6;
    }

    /* Glass Card Inner */
    .card-inner {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        background: linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.08) 0%,
            rgba(255, 255, 255, 0.02) 100%
        );
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow:
            0 8px 32px rgba(0, 0, 0, 0.3),
            inset 0 1px 0 rgba(255, 255, 255, 0.1);
        transition: all 0.4s ease;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .project-card:hover .card-inner {
        border-color: rgba(139, 92, 246, 0.5);
        background: linear-gradient(
            135deg,
            rgba(0, 0, 0, 0.6) 0%,
            rgba(0, 0, 0, 0.4) 100%
        );
        box-shadow:
            0 16px 48px rgba(0, 0, 0, 0.5),
            inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }

    /* Image Section */
    .card-image {
        position: relative;
        width: 100%;
        height: 200px;
        overflow: hidden;
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .project-card:hover .card-image img {
        transform: scale(1.1);
    }

    .image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            transparent 0%,
            rgba(11, 14, 20, 0.8) 100%
        );
    }

    /* Content Section */
    .card-content {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    /* Tags */
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .tag {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: rgba(139, 92, 246, 1);
        background: rgba(139, 92, 246, 0.15);
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-radius: 100px;
        transition: all 0.3s ease;
    }

    .project-card:hover .tag {
        background: rgba(139, 92, 246, 0.25);
        border-color: rgba(139, 92, 246, 0.5);
    }

    /* Title */
    .card-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.75rem;
        line-height: 1.3;
        transition: color 0.3s ease;
    }

    .title-link {
        text-decoration: none;
        color: inherit;
    }

    .title-link:hover {
        text-decoration: none;
    }

    .project-card:hover .card-title {
        text-shadow:
            0 0 20px rgba(139, 92, 246, 0.8),
            0 0 40px rgba(139, 92, 246, 0.4);
    }

    /* Description */
    .card-description {
        font-size: 0.95rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 1.25rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color 0.3s ease;
    }

    .project-card:hover .card-description {
        color: rgba(255, 255, 255, 0.85);
    }

    /* Actions */
    .card-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: auto;
    }

    .action-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 0.9rem;
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 100px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .details-link {
        color: rgba(255, 255, 255, 0.6);
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .details-link:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .github-link {
        color: rgba(255, 255, 255, 0.7);
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .github-link:hover {
        color: #fff;
        background: rgba(139, 92, 246, 0.15);
        border-color: rgba(139, 92, 246, 0.3);
    }

    .demo-link {
        color: rgba(139, 92, 246, 0.9);
        background: rgba(139, 92, 246, 0.1);
        border: 1px solid rgba(139, 92, 246, 0.2);
    }

    .demo-link:hover {
        background: rgba(139, 92, 246, 0.2);
        border-color: rgba(139, 92, 246, 0.4);
        color: #fff;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .card-title {
            font-size: 1.2rem;
        }

        .card-description {
            font-size: 0.9rem;
        }

        .card-image {
            height: 160px;
        }
    }
</style>
