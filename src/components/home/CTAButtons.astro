<div class="flex flex-col items-center gap-4 mt-10 z-10 relative pointer-events-auto hero-cta" style="opacity:0">

    <div class="flex flex-wrap gap-4 justify-center">
        <a href="/projects"
            class="group relative px-7 py-3 font-semibold text-black bg-white rounded-full overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(167,139,250,0.4)]">
            <span class="relative z-10 flex items-center gap-2">View Projects <span class="transition-transform group-hover:translate-x-1">&rarr;</span></span>
        </a>

        <a href="/contact"
            class="group px-7 py-3 font-semibold text-white rounded-full border border-white/25 bg-white/5 backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-white/15 hover:border-white/40">
            <span class="flex items-center gap-2">Contact Me <span class="transition-transform group-hover:translate-x-1">&nearr;</span></span>
        </a>

        <a href="/resume"
            class="group px-7 py-3 font-semibold text-white rounded-full border border-white/15 bg-white/5 backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-white/10 hover:border-purple-400/50">
            <span class="flex items-center gap-2">Resume &darr;</span>
        </a>
    </div>

    <!-- GitHub + LinkedIn only -->
    <div class="flex items-center gap-6 mt-2">
        <a href="https://github.com/srivatsagorti" target="_blank"
            class="text-sm font-medium transition-all hover:text-white hover:scale-105" style="color:rgba(255,255,255,0.4)">
            GitHub
        </a>
        <span style="color:rgba(255,255,255,0.15)">|</span>
        <a href="https://linkedin.com/in/srivatsagorti" target="_blank"
            class="text-sm font-medium transition-all hover:text-white hover:scale-105" style="color:rgba(255,255,255,0.4)">
            LinkedIn
        </a>
    </div>
</div>

<script>
import { gsap } from 'gsap';
gsap.fromTo('.hero-cta',
    { y: 20, opacity: 0 },
    { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out', delay: 2.5 }
);
</script>
