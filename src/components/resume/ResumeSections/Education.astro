---
const education = [
    {
        degree: "PGDM – Rural & Business Analytics",
        institution: "WeSchool, Mumbai (S P Mandali)",
        year: "2025 – 2027",
        tags: ["Management", "Analytics", "Strategy"],
        icon: "🎓",
        current: true
    },
    {
        degree: "BCA – Data Science",
        institution: "Bennett University",
        year: "2020 – 2023",
        tags: ["Data Science", "Machine Learning", "Python"],
        icon: "🏫",
        current: false
    },
    {
        degree: "Class XII – BIEAP",
        institution: "Sri Chaitanya Junior College",
        year: "2018 – 2020",
        tags: ["Science", "Mathematics"],
        icon: "📘",
        current: false
    },
    {
        degree: "Class X – ICSE",
        institution: "Loyola School, Jamshedpur",
        year: "2018",
        tags: ["Academics", "Co-curriculars"],
        icon: "📗",
        current: false
    },
];
---
<section class="reveal-section">
    <h2 class="section-title">Education</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6 reveal-stagger">
        {education.map((edu) => (
            <div class="stagger-child glass-card p-6 flip-card group cursor-default border-l-2 border-white/20 hover:border-white/60 transition-all">
                <div class="flex items-start justify-between mb-3">
                    <span class="text-2xl">{edu.icon}</span>
                    {edu.current && (
                        <span class="flex items-center gap-1 text-xs text-green-400 border border-green-400/30 bg-green-400/10 px-2 py-0.5 rounded-full">
                            <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse inline-block"></span>
                            Currently Enrolled
                        </span>
                    )}
                </div>
                <h3 class="text-base font-bold text-white mb-1">{edu.degree}</h3>
                <p class="text-gray-400 text-sm">{edu.institution}</p>
                <p class="text-gray-500 text-xs mt-1 mb-4">{edu.year}</p>
                <div class="flex flex-wrap gap-2">
                    {edu.tags.map(tag => (
                        <span class="px-2 py-0.5 text-xs rounded-full bg-white/8 border border-white/15 text-gray-300">{tag}</span>
                    ))}
                </div>
            </div>
        ))}
    </div>
</section>
