---
const certs = [
    { title: "KPMG Data Analytics Consulting", issuer: "Forge", status: "Completed", icon: "\ud83d\udccb" },
    { title: "Power BI by PwC", issuer: "Forge", status: "Completed", icon: "\ud83d\udcca" },
    { title: "TATA Data Visualisation", issuer: "Forge", status: "Completed", icon: "\ud83d\udcc8" },
    { title: "Bloomberg Market Concepts (BMC)", issuer: "Bloomberg", status: "Ongoing", icon: "\ud83d\udcb9" },
];
---
<section class="reveal-section">
    <h2 class="section-title">Certifications</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-6">
        {certs.map((cert) => (
            <div class="glass-card p-6 hover:border-white/40 transition-all">
                <div class="flex items-start justify-between">
                    <div class="flex gap-4 items-start">
                        <span class="text-3xl">{cert.icon}</span>
                        <div>
                            <h3 class="text-white font-semibold text-base">{cert.title}</h3>
                            <p class="text-gray-300 text-sm mt-1">{cert.issuer}</p>
                        </div>
                    </div>
                    <span class={`text-sm px-3 py-1 rounded-full border font-medium ${ cert.status === 'Ongoing' ? 'border-yellow-400/50 text-yellow-200 bg-yellow-400/10 animate-pulse' : 'border-green-400/50 text-green-200 bg-green-400/10' }`}>
                        {cert.status}
                    </span>
                </div>
            </div>
        ))}
    </div>
</section>
