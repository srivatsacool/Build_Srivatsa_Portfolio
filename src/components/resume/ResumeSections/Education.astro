---
const education = [
    {
        degree: "PGDM \u2013 Rural & Business Analytics",
        institution: "WeSchool, Mumbai (S P Mandali)",
        year: "2025 \u2013 2027",
        tags: ["Management", "Analytics", "Strategy"],
        icon: "\ud83c\udf93",
        current: true
    },
    {
        degree: "BCA \u2013 Data Science",
        institution: "Bennett University",
        year: "2020 \u2013 2023",
        tags: ["Data Science", "Machine Learning", "Python"],
        icon: "\ud83c\udfeb",
        current: false
    },
    {
        degree: "Class XII \u2013 BIEAP",
        institution: "Sri Chaitanya Junior College",
        year: "2018 \u2013 2020",
        tags: ["Science", "Mathematics"],
        icon: "\ud83d\udcd8",
        current: false
    },
    {
        degree: "Class X \u2013 ICSE",
        institution: "Loyola School, Jamshedpur",
        year: "2018",
        tags: ["Academics", "Co-curriculars"],
        icon: "\ud83d\udcd7",
        current: false
    },
];
---
<section class="reveal-section">
    <h2 class="section-title">Education</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-6">
        {education.map((edu) => (
            <div class="glass-card p-6 flip-card border-l-2 border-white/30 hover:border-white/70 transition-all">
                <div class="flex items-start justify-between mb-3">
                    <span class="text-3xl">{edu.icon}</span>
                    {edu.current && (
                        <span class="flex items-center gap-1.5 text-sm text-green-300 border border-green-400/40 bg-green-400/10 px-3 py-1 rounded-full font-medium">
                            <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse inline-block"></span>
                            Currently Enrolled
                        </span>
                    )}
                </div>
                <h3 class="text-lg font-bold text-white mb-1">{edu.degree}</h3>
                <p class="text-gray-200 text-base">{edu.institution}</p>
                <p class="text-gray-400 text-sm mt-1 mb-4">{edu.year}</p>
                <div class="flex flex-wrap gap-2">
                    {edu.tags.map(tag => (
                        <span class="px-3 py-1 text-sm rounded-full bg-white/10 border border-white/20 text-gray-100 font-medium">{tag}</span>
                    ))}
                </div>
            </div>
        ))}
    </div>
</section>
